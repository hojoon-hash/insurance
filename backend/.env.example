# Railway가 PORT를 자동 주입하므로 보통 설정 불필요(로컬 테스트 시에만 사용).
PORT=5000

# CORS 허용 도메인(쉼표로 구분). 미설정 시 전체 허용.
# 도메인 연결 후 예: https://smilesam.net,https://www.smilesam.net
ALLOWED_ORIGINS=

# 구글 시트 Apps Script 웹앱 URL. 리드(상담신청)를 이 시트로 전송.
# 예: https://script.google.com/macros/s/XXXXX/exec
GOOGLE_SHEETS_WEBHOOK_URL=
